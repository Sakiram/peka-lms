{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/controllers/inviteController.ts", "src/controllers/orgController.ts", "src/controllers/userController.ts", "src/controllers/authController.ts"],
  "exclude": ["node_modules"]
}